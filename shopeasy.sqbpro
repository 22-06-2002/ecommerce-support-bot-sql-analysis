<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="shopeasy.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1385"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="conversations" custom_title="0" dock_id="1" table="4,13:mainconversations"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- 1. Overall accuracy
SELECT ROUND(100.0 * SUM(CASE WHEN correct='Y' THEN 1 ELSE 0 END) / COUNT(*), 1) AS accuracy_pct
FROM conversations;

-- 2. Volume and accuracy by intent
SELECT intent, COUNT(*) AS total,
       ROUND(100.0 * SUM(CASE WHEN correct='Y' THEN 1 ELSE 0 END) / COUNT(*), 1) AS accuracy_pct
FROM conversations
GROUP BY intent
ORDER BY total DESC;

-- 3. Top failure types
SELECT failure_type, COUNT(*) AS total
FROM conversations
WHERE correct='N'
GROUP BY failure_type
ORDER BY total DESC;

-- 4. Accuracy by language
SELECT language, COUNT(*) AS total,
       ROUND(100.0 * SUM(CASE WHEN correct='Y' THEN 1 ELSE 0 END) / COUNT(*), 1) AS accuracy_pct
FROM conversations
GROUP BY language;

-- 5. Bot resolution rate vs tickets
SELECT ROUND(100.0 * SUM(CASE WHEN resolved_by_bot='Y' THEN 1 ELSE 0 END) / COUNT(*), 1) AS resolved_pct,
       ROUND(100.0 * SUM(CASE WHEN ticket_created='Y' THEN 1 ELSE 0 END) / COUNT(*), 1) AS ticket_pct
FROM conversations;

-- 6. Intents causing the most tickets (window function)
WITH t AS (
  SELECT intent, COUNT(*) AS tickets FROM conversations WHERE ticket_created='Y' GROUP BY intent
)
SELECT intent, tickets, RANK() OVER (ORDER BY tickets DESC) AS rnk FROM t;

-- 7. Busiest hours
SELECT SUBSTR(time, 1, 2) AS hour, COUNT(*) AS chats
FROM conversations
GROUP BY hour
ORDER BY chats DESC;

-- 8. Missed escalations
SELECT COUNT(*) AS missed
FROM conversations
WHERE intent='complaint' AND failure_type='escalation_missed';</sql><current_tab id="0"/></tab_sql></sqlb_project>
